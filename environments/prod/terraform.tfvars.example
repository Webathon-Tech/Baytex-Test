# Values this repository is TESTED with: an isolated sandbox subscription under the "vkp" prefix, so nothing here can
# collide with Baytex's globally unique resource names. For the configuration intended for Baytex, see
# baytex.terraform.tfvars.example alongside this file.
#
# The whole of this file is held in the TFVARS variable on the prod-plan and prod-apply GitHub Environments; the
# workflow writes it to disk at run time, which is why no environment-specific value is committed to git.

# Entra tenant and the subscription this environment deploys into.
tenant_id       = "be945e7a-2e17-4b44-926f-512e85873eec"
subscription_id = "6a3bb170-5159-4bff-860b-aa74fb762697"

# From the Databricks account console. The metastore is the existing regional one; the platform binds to it rather than
# creating its own.
databricks_account_id = "e198df6c-3932-4959-847b-5257ea8dec5a"
existing_metastore_id = "9bf4d8e9-c078-4730-a533-51d10f5c44d6"

# These five compose every resource name: rg-<organization>-<workload>-<environment>-<purpose>-<region_short>-<instance>
location     = "canadacentral"
organization = "vkp"
workload     = "dbx"
environment  = "prod"
region_short = "cnc"
instance     = "001"

owner               = "Platform Engineering"
cost_centre         = "VKP-DBX-PROD"
data_classification = "Internal"

# Spoke address space. Each environment takes a separate /20 so the three can coexist and peer to the same hub.
vnet_cidr                        = "10.99.32.0/20"
databricks_host_subnet_cidr      = "10.99.32.0/24"
databricks_container_subnet_cidr = "10.99.33.0/24"
private_endpoint_subnet_cidr     = "10.99.34.0/26"
proxy_subnet_cidr                = "10.99.34.64/26"

# Azure-provided DNS. A real deployment points at corporate resolvers instead.
dns_servers = ["168.63.129.16"]

# The hub this spoke peers to and routes through.
hub_subscription_id       = "6a3bb170-5159-4bff-860b-aa74fb762697"
hub_resource_group_name   = "rg-sbx-hub-cnc-001"
hub_vnet_name             = "vnet-sbx-hub-cnc-001"
hub_vnet_id               = "/subscriptions/6a3bb170-5159-4bff-860b-aa74fb762697/resourceGroups/rg-sbx-hub-cnc-001/providers/Microsoft.Network/virtualNetworks/vnet-sbx-hub-cnc-001"
cisco_firewall_private_ip = "10.98.0.4"

# True is possible here because the hub is in the same subscription as the spoke. Where the hub belongs to another
# subscription the peering is usually created by whoever owns it, and this is set to false.
create_spoke_to_hub_peering = true

# Prefixes routed to cisco_firewall_private_ip rather than out through the NAT gateway.
on_prem_routes = {
  onprem_sim = {
    address_prefix = "10.98.1.0/24"
  }
}

# One Allow-SSH rule is created per CIDR on the proxy NSG. Empty creates none, which is the intended posture: the
# proxy VMs are reachable through "az vm run-command invoke" without opening port 22.
admin_ssh_source_cidrs = []

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMhki1LbqhnxgL8qjn0rcCIy6b/7NYAW6AT1D+6NvlNJ vkp-platform"

proxy_vm_size = "Standard_D4s_v3"
proxy_vm_private_ips = [
  "10.99.34.70",
  "10.99.34.71"
]

# One HAProxy frontend and one Private Link Service per destination. frontend_ip and pls_nat_ip must both sit inside
# proxy_subnet_cidr and must not collide with proxy_vm_private_ips.
on_prem_endpoints = {
  sqlsim = {
    frontend_ip = "10.99.34.75"
    pls_nat_ip  = "10.99.34.85"
    listen_port = 1433
    target_fqdn = "sqlsim.sandbox.baytexdemo.net"
    target_port = 1433
    domain_name = "sqlsim.sandbox.baytexdemo.net"
  }
  orasim = {
    frontend_ip = "10.99.34.76"
    pls_nat_ip  = "10.99.34.86"
    listen_port = 1521
    target_fqdn = "orasim.sandbox.baytexdemo.net"
    target_port = 1521
    domain_name = "orasim.sandbox.baytexdemo.net"
  }
}

# allow_all makes the Private Link Services discoverable by any subscription. Listing a subscription under
# auto_approval means its connection requests are accepted without anyone clicking approve.
allow_all_subscriptions_pls_visibility = true
pls_visibility_subscription_ids        = []
pls_auto_approval_subscription_ids     = ["6a3bb170-5159-4bff-860b-aa74fb762697"]

# Both must be globally unique across all of Azure. The organisation prefix is what keeps them from colliding.
data_storage_account_name           = "stvkpdbxprodcnc001"
workspace_root_storage_account_name = "stvkpdbxprodroot001"

data_containers = ["managed", "external", "landing", "checkpoints"]

# Private DNS zones the blob and dfs private endpoints register into. Creating a zone group needs write access on the
# zone, so where the zones live in another subscription the owner grants it or these are left empty.
blob_private_dns_zone_ids = ["/subscriptions/6a3bb170-5159-4bff-860b-aa74fb762697/resourceGroups/rg-sbx-hub-cnc-001/providers/Microsoft.Network/privateDnsZones/privatelink.blob.core.windows.net"]
dfs_private_dns_zone_ids  = ["/subscriptions/6a3bb170-5159-4bff-860b-aa74fb762697/resourceGroups/rg-sbx-hub-cnc-001/providers/Microsoft.Network/privateDnsZones/privatelink.dfs.core.windows.net"]

# The workspace front end stays public so users, Power BI and GitHub can reach it. Classic compute still has no public
# IPs, and the Databricks-managed default storage is firewalled.
workspace_public_network_access_enabled     = true
workspace_default_storage_firewall_enabled  = true
workspace_infrastructure_encryption_enabled = true

# Optional creation-time catalog. null leaves Unity Catalog setup to whoever owns the data layer.
default_catalog_initial_name = null

enable_diagnostics           = true
log_analytics_retention_days = 30

# Email receivers on the platform action group. Empty creates the group with no receivers.
alert_email_receivers = {}
