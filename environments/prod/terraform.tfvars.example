# Values for the prod environment.
# The whole of this file is held in the TFVARS variable on the prod-plan and prod-apply GitHub Environments, and the workflows write it to disk as terraform.tfvars at run time.
# Values for Baytex's own subscriptions are kept in baytex.terraform.tfvars.example alongside this file.
# Values follow the section order of variables.tf.

# ----------------------------------------------------------------------------------------------------------------------
# Subscription and Databricks account
# ----------------------------------------------------------------------------------------------------------------------

# Entra tenant and the subscription this environment deploys into.
tenant_id       = "be945e7a-2e17-4b44-926f-512e85873eec"
subscription_id = "6a3bb170-5159-4bff-860b-aa74fb762697"

# From the Databricks account console.
# The metastore is the existing regional one; the platform reports it in the unity_catalog_handoff output and does not assign it.
databricks_account_id = "e198df6c-3932-4959-847b-5257ea8dec5a"
existing_metastore_id = "9bf4d8e9-c078-4730-a533-51d10f5c44d6"

# ----------------------------------------------------------------------------------------------------------------------
# Naming
# ----------------------------------------------------------------------------------------------------------------------

# Every resource name is composed as <type>-<organization>-<workload>-<environment>-<purpose>-<region_short>-<instance>.
location     = "canadacentral"
organization = "vkp"
workload     = "dbx"
environment  = "prod"
region_short = "cnc"
instance     = "001"

# ----------------------------------------------------------------------------------------------------------------------
# Tags
# ----------------------------------------------------------------------------------------------------------------------

owner               = "Platform Engineering"
cost_centre         = "VKP-DBX-PROD"
data_classification = "Internal"

# Extra tags merged over the standard tags. Example:
#   additional_tags = { Department = "BI" }
additional_tags = {}

# ----------------------------------------------------------------------------------------------------------------------
# Spoke network
# ----------------------------------------------------------------------------------------------------------------------

# Each environment uses its own /20, so all three can peer with the same hub without overlapping.
vnet_cidr                        = "10.99.32.0/20"
databricks_host_subnet_cidr      = "10.99.32.0/24"
databricks_container_subnet_cidr = "10.99.33.0/24"
private_endpoint_subnet_cidr     = "10.99.34.0/26"
proxy_subnet_cidr                = "10.99.34.64/26"

# DNS servers for the VNet and the HAProxy resolver. 168.63.129.16 is Azure-provided DNS.
dns_servers = ["168.63.129.16"]

# ----------------------------------------------------------------------------------------------------------------------
# Hub peering and routing
# ----------------------------------------------------------------------------------------------------------------------

# The hub VNet. Its subscription, resource group and name are read from this ID.
hub_vnet_id = "/subscriptions/6a3bb170-5159-4bff-860b-aa74fb762697/resourceGroups/rg-sbx-hub-cnc-001/providers/Microsoft.Network/virtualNetworks/vnet-sbx-hub-cnc-001"

# VNet peering with the hub, one flag per direction.
# create_spoke_to_hub_peering creates the peering on the spoke VNet, and create_hub_to_spoke_peering creates the peering on the hub VNet.
# When the hub is in another subscription, both need Network Contributor on the hub VNet for the deployment service principal.
# While both are false, Terraform makes no calls to the hub subscription, and the hub_side_peering_command output gives the command for the hub owner.
create_spoke_to_hub_peering = false
create_hub_to_spoke_peering = false

# Next hop for both route tables.
cisco_firewall_private_ip = "10.98.0.4"

# Prefixes the Databricks subnets send to the firewall; the rest of their traffic leaves through the NAT Gateway.
# The proxy and private endpoint subnets send all traffic to the firewall and need no entry here.
# One aggregate prefix normally covers every spoke, so traffic to another spoke reaches the firewall without a route per spoke.
# Azure selects the longest matching prefix, so an aggregate never captures traffic that belongs to a more specific route.
firewall_routes = {
  azure-landing-zone = {
    address_prefix = "10.99.0.0/16"
  }
  onprem-sim = {
    address_prefix = "10.98.1.0/24"
  }
}

# ----------------------------------------------------------------------------------------------------------------------
# Network security group rules
# ----------------------------------------------------------------------------------------------------------------------

# Rules added to both Databricks subnet NSGs, keyed by rule name.
# Azure Databricks maintains its own rules on these NSGs, so these priorities start at 1000.
# Network security groups match addresses, CIDR ranges and service tags, never domain names.
# Allow rules record the approved destinations without restricting anything, because the Databricks subnets already reach the internet through the NAT Gateway.
# To restrict them, add a Deny rule with a higher priority number than every Allow rule.
databricks_nsg_rules = {
  Allow-AzureSql = {
    priority                   = 1000
    destination_address_prefix = "Sql.CanadaCentral"
    destination_port_ranges    = ["1433"]
    description                = "Azure SQL Database in this region."
  }
  Allow-PowerBI = {
    priority                   = 1010
    destination_address_prefix = "PowerBI.CanadaCentral"
    destination_port_ranges    = ["443"]
    description                = "Power BI service."
  }
}

# Azure's own default rule lets any address in the VNet, the hub and the networks reached through it open any port on
# the HAProxy VMs. This closes that, leaving only the load balancer health probe, Private Link Service traffic on the
# listener ports and any approved administrative SSH.
proxy_deny_other_vnet_inbound = true

# Rules added to the proxy NSG alongside the health probe, Private Link Service and SSH rules the platform creates.
# Priorities run from 1000 to 4095; 4096 is taken by the rule that denies everything else from the virtual network.
proxy_nsg_rules = {
  Allow-Ubuntu-Mirrors = {
    priority                   = 1000
    destination_address_prefix = "Internet"
    destination_port_ranges    = ["80", "443"]
    description                = "Ubuntu package mirrors, reached through the firewall."
  }
}

# ----------------------------------------------------------------------------------------------------------------------
# Data foundation
# ----------------------------------------------------------------------------------------------------------------------

# Globally unique across Azure.
data_storage_account_name = "stvkpdbxprodcnc001"

data_containers = ["managed", "external", "landing", "checkpoints"]

# Private DNS zones the blob and dfs private endpoints register in.
# When the zones are in another subscription, the deployment service principal needs Private DNS Zone Contributor on each zone.
# Leave both empty to create the private endpoints without DNS zone groups.
blob_private_dns_zone_ids = ["/subscriptions/6a3bb170-5159-4bff-860b-aa74fb762697/resourceGroups/rg-sbx-hub-cnc-001/providers/Microsoft.Network/privateDnsZones/privatelink.blob.core.windows.net"]
dfs_private_dns_zone_ids  = ["/subscriptions/6a3bb170-5159-4bff-860b-aa74fb762697/resourceGroups/rg-sbx-hub-cnc-001/providers/Microsoft.Network/privateDnsZones/privatelink.dfs.core.windows.net"]

# Static addresses for the two private endpoints, so a rebuilt environment keeps the addresses already published in DNS.
# Both must be inside private_endpoint_subnet_cidr and above the four addresses Azure reserves at the start of every subnet.
blob_private_endpoint_ip = "10.99.34.4"
dfs_private_endpoint_ip  = "10.99.34.5"

# ----------------------------------------------------------------------------------------------------------------------
# HAProxy tier
# ----------------------------------------------------------------------------------------------------------------------

# One Allow-SSH rule per CIDR on the proxy NSG.
# Empty creates none, and the VMs remain reachable through az vm run-command. Example:
#   admin_ssh_source_cidrs = ["10.40.240.0/24"]
admin_ssh_source_cidrs = []

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMhki1LbqhnxgL8qjn0rcCIy6b/7NYAW6AT1D+6NvlNJ vkp-platform"

# Two or three VM IPs, in zone order: zone 1, zone 2 and optionally zone 3. All must be inside proxy_subnet_cidr.
proxy_vm_size = "Standard_D4s_v6"
proxy_vm_private_ips = [
  "10.99.34.70",
  "10.99.34.71"
]

# One load balancer frontend, Private Link Service and HAProxy listener per destination.
# frontend_ip and pls_nat_ip must be inside proxy_subnet_cidr and different from every other address in this section.
on_prem_endpoints = {
  sqlsim = {
    frontend_ip = "10.99.34.75"
    pls_nat_ip  = "10.99.34.85"
    listen_port = 1433
    target_fqdn = "sqlsim.sandbox.baytexdemo.net"
    target_port = 1433
    domain_name = "sqlsim.sandbox.baytexdemo.net"
  }
  orasim = {
    frontend_ip = "10.99.34.76"
    pls_nat_ip  = "10.99.34.86"
    listen_port = 1521
    target_fqdn = "orasim.sandbox.baytexdemo.net"
    target_port = 1521
    domain_name = "orasim.sandbox.baytexdemo.net"
  }
}

# ----------------------------------------------------------------------------------------------------------------------
# Private Link Service access
# ----------------------------------------------------------------------------------------------------------------------

# Auto-approval subscriptions must also be in the visibility list, and all-subscription visibility cannot be combined with auto-approval.
allow_all_subscriptions_pls_visibility = false
pls_visibility_subscription_ids        = ["6a3bb170-5159-4bff-860b-aa74fb762697"]
pls_auto_approval_subscription_ids     = ["6a3bb170-5159-4bff-860b-aa74fb762697"]

# ----------------------------------------------------------------------------------------------------------------------
# Databricks workspace
# ----------------------------------------------------------------------------------------------------------------------

# Globally unique across Azure, and set only when the workspace is created.
workspace_root_storage_account_name = "stvkpdbxprodroot001"

# The front end stays reachable for users, Power BI and GitHub. Classic compute has no public IPs either way.
workspace_public_network_access_enabled = true

# Set only when the workspace is created.
workspace_infrastructure_encryption_enabled = true

# ----------------------------------------------------------------------------------------------------------------------
# Serverless egress
# ----------------------------------------------------------------------------------------------------------------------

# The Databricks network policy is the only place an outbound allow list can be expressed by domain name.
# It applies to serverless compute. Classic compute leaves through the NAT Gateway and is governed by the route tables, the network security group rules and the firewall.
create_serverless_network_policy = true
# Point the workspace at the policy above.
# Set this to false, and apply, before removing the policy or destroying the environment: Azure Databricks refuses to
# delete a policy a running workspace still refers to.
attach_serverless_network_policy = true


# RESTRICTED_ACCESS limits serverless compute to the domain names below, and ENFORCED blocks everything else.
# Set enforcement to DRY_RUN to record what would be blocked without blocking it while the list is being confirmed.
serverless_egress_restriction_mode = "RESTRICTED_ACCESS"
serverless_egress_enforcement_mode = "ENFORCED"

# The policy matches the domain name only, never a port or a path.
# The data storage account and the on-premises destinations are reached through the private endpoint rules of the Network Connectivity Configuration and need no entry here.
serverless_allowed_internet_destinations = [
  "pypi.org",
  "files.pythonhosted.org"
]

# ----------------------------------------------------------------------------------------------------------------------
# Operations
# ----------------------------------------------------------------------------------------------------------------------

log_analytics_retention_days = 30
enable_diagnostics           = true
enable_alerts                = true

# Receiver name to email address. Empty creates no action group. Example:
#   alert_email_receivers = { cloud_operations = "cloud-operations@example.com" }
alert_email_receivers = {}
