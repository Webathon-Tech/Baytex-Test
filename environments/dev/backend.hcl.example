# Backend settings for initialising the dev platform root by hand: terraform init -backend-config=backend.hcl
# Copy to backend.hcl, which is gitignored, and match the TF_STATE_* variables on the dev-plan GitHub Environment.
resource_group_name  = "rg-bte-dbx-dev-tfstate-cnc-001"
storage_account_name = "stbtedbxdevtfcnc001"
container_name       = "tfstate"
key                  = "dev/platform.tfstate"
use_azuread_auth     = true
