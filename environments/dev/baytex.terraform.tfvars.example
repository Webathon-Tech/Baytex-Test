# BAYTEX DELIVERY VALUES for the dev environment.
#
# This is the configuration intended for Baytex's own subscriptions. It is kept alongside terraform.tfvars.example,
# which holds the values this repository is tested with, so the two never have to be reconstructed from memory.
#
# To deliver: copy the whole of this file into the BAYTEX_TFVARS content for dev, or paste it over
# terraform.tfvars.example in the Baytex repository.

# Dev environment values. cost_centre is provisional. IPAM sign-off pending.

tenant_id       = "9a6302b1-6a51-4f41-ad6b-ad23218c074d"
subscription_id = "e3a6598e-28b1-4d6a-8698-6683cd1d6995"

# From the Baytex Databricks account console.
databricks_account_id = "1ff56ce7-99f9-4d29-b2d7-5da177c5f55b"
existing_metastore_id = "858890e3-8d95-42c7-922e-4107a0055500"

location     = "canadacentral"
organization = "bte"
workload     = "dbx"
environment  = "dev"
region_short = "cnc"
instance     = "001"

owner               = "Baytex Infrastructure"
cost_centre         = "BTX-DBX-DEV"
data_classification = "Internal"

# Spoke address space.
vnet_cidr                        = "10.40.96.0/20"
databricks_host_subnet_cidr      = "10.40.96.0/24"
databricks_container_subnet_cidr = "10.40.97.0/24"
private_endpoint_subnet_cidr     = "10.40.98.0/26"
proxy_subnet_cidr                = "10.40.99.0/26"

# Corporate DNS servers, in preference order. Applied to the VNet and to the
# HAProxy resolver.
dns_servers = [
  "10.40.128.5",
  "10.40.128.6",
  "172.19.65.39",
  "172.19.65.3",
  "172.19.96.124"
]

hub_subscription_id       = "557d1301-8d98-483e-ac69-4f23bf2cb2eb"
hub_resource_group_name   = "rg-network-bte-hub-cnc-02"
hub_vnet_name             = "vnet-bte-hub-cnc-02"
hub_vnet_id               = "/subscriptions/557d1301-8d98-483e-ac69-4f23bf2cb2eb/resourceGroups/rg-network-bte-hub-cnc-02/providers/Microsoft.Network/virtualNetworks/vnet-bte-hub-cnc-02"
cisco_firewall_private_ip = "10.40.240.36"

# Set false if Baytex creates both peering directions.
create_spoke_to_hub_peering = false

# Prefixes routed to cisco_firewall_private_ip. This route table carries no 0.0.0.0/0, so a destination not named here
# leaves through the NAT Gateway to the internet rather than reaching on-premises.
on_prem_routes = {
  azure_spokes = {
    address_prefix = "10.40.0.0/16"
  }
  baytex_onprem = {
    address_prefix = "172.19.64.0/18"
  }
  # btx-sql01.trimble.vpn sits on the vendor VPN, outside the corporate range above. Baytex source-NATs the flow to
  # 172.23.227.82 before the tunnel, so their NAT policy must list this spoke's proxy subnet as a permitted source.
  trimble_vendor = {
    address_prefix = "172.23.178.197/32"
  }
}

# One Allow-SSH rule is created per CIDR on the proxy NSG. Empty creates none.
# Empty creates no SSH rule, which is the intended posture. Example if you need one:
#   admin_ssh_source_cidrs = ["10.40.240.0/24"]
admin_ssh_source_cidrs = []

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIpC6AYv2TDM3+DFJJYLSy3hQZjIRMoFKkB0xtvf2PMx baytex-terraform"

proxy_vm_size = "Standard_D4s_v3"
proxy_vm_private_ips = [
  "10.40.99.5",
  "10.40.99.6"
]

# On-premises destinations. SQL03YYC and Trimble/TMW are not configured.
# target_fqdn is resolved at run time by the HAProxy baytex_dns resolver.
# Trailing comments are the confirmed IP addresses.
on_prem_endpoints = {
  sqlbidb01yyc = {
    frontend_ip = "10.40.99.11"
    pls_nat_ip  = "10.40.99.21"
    listen_port = 1433
    target_fqdn = "sqlbidb01yyc.baytexenergy.com" # 172.19.77.45
    target_port = 1433
    domain_name = "sqlbidb01yyc.baytexenergy.com"
  }
  sqlbidb01yyc_t = {
    frontend_ip = "10.40.99.12"
    pls_nat_ip  = "10.40.99.22"
    listen_port = 1433
    target_fqdn = "sqlbidb01yyc-t.baytexenergy.com" # 172.19.96.44
    target_port = 1433
    domain_name = "sqlbidb01yyc-t.baytexenergy.com"
  }
  sql14yyc = {
    frontend_ip = "10.40.99.13"
    pls_nat_ip  = "10.40.99.23"
    listen_port = 1433
    target_fqdn = "sql14yyc.baytexenergy.com" # 172.19.77.94
    target_port = 1433
    domain_name = "sql14yyc.baytexenergy.com"
  }
  sql6 = {
    frontend_ip = "10.40.99.16"
    pls_nat_ip  = "10.40.99.26"
    listen_port = 1433
    target_fqdn = "sql6.baytexenergy.com" # 172.19.77.123
    target_port = 1433
    domain_name = "sql6.baytexenergy.com"
  }
  ora33yyc = {
    frontend_ip = "10.40.99.14"
    pls_nat_ip  = "10.40.99.24"
    listen_port = 1521
    target_fqdn = "ora33yyc.baytexenergy.com" # 172.19.77.88
    target_port = 1521
    domain_name = "ora33yyc.baytexenergy.com"
  }
  ora33yyc_t = {
    frontend_ip = "10.40.99.15"
    pls_nat_ip  = "10.40.99.25"
    listen_port = 1521
    target_fqdn = "ora33yyc-t.baytexenergy.com" # 172.19.96.112
    target_port = 1521
    domain_name = "ora33yyc-t.baytexenergy.com"
  }
  sql03yyc = {
    frontend_ip = "10.40.99.17"
    pls_nat_ip  = "10.40.99.27"
    listen_port = 1433
    target_fqdn = "sql03yyc.baytexenergy.com" # address to be confirmed by Baytex
    target_port = 1433
    domain_name = "sql03yyc.baytexenergy.com"
  }
  trimble_sql = {
    frontend_ip = "10.40.99.18"
    pls_nat_ip  = "10.40.99.28"
    listen_port = 1433
    target_fqdn = "btx-sql01.trimble.vpn" # 172.23.178.197, reached over the Trimble vendor VPN
    target_port = 1433
    domain_name = "btx-sql01.trimble.vpn"
  }
}

# allow_all = true makes the Private Link Services discoverable by any
# subscription. Empty auto-approval means every connection request requires
# manual approval.
allow_all_subscriptions_pls_visibility = true
# Subscriptions that may discover the Private Link Services. Example:
#   pls_visibility_subscription_ids = ["00000000-0000-0000-0000-000000000000"]
pls_visibility_subscription_ids        = []
# Must be a subset of the visibility list, or Azure rejects the create. Example:
#   pls_auto_approval_subscription_ids = ["00000000-0000-0000-0000-000000000000"]
pls_auto_approval_subscription_ids     = []

# Must be globally unique.
data_storage_account_name           = "stbtedbxdevcnc001"
workspace_root_storage_account_name = "stbtedbxdevroot001"

data_containers = ["managed", "external", "landing", "checkpoints"]

# Left empty on purpose. Attaching a private endpoint to a DNS zone needs
# Microsoft.Network/privateDnsZones/join/action ON THE ZONE, which Contributor on this subscription does not
# grant when the zone lives in the hub subscription. Whoever owns the hub must grant the deployment service
# principal Private DNS Zone Contributor on each zone before these can be set. Example once granted:
#   blob_private_dns_zone_ids = ["/subscriptions/<hub-sub>/resourceGroups/<hub-rg>/providers/Microsoft.Network/privateDnsZones/privatelink.blob.core.windows.net"]
blob_private_dns_zone_ids = []
dfs_private_dns_zone_ids  = []

# Workspace front-end is public. Classic compute has no public IPs.
workspace_public_network_access_enabled     = true
workspace_default_storage_firewall_enabled  = true
workspace_infrastructure_encryption_enabled = true

# Optional creation-time default catalog name.
# null leaves Unity Catalog setup to whoever owns the data layer. Example:
#   default_catalog_initial_name = "main"
default_catalog_initial_name = null

enable_diagnostics           = true
log_analytics_retention_days = 90

alert_email_receivers = {
  # cloud_operations = "cloud-operations@baytexenergy.com"
}
