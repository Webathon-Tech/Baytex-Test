# Terraform working directories and state
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variables files and backend config.
# Each environment's values are tracked in environments/<env>/terraform.tfvars and bootstrap/<env>/terraform.tfvars.
# Any other variables file, such as the Unity Catalog reference's, stays out of git.
*.tfvars
*.tfvars.json
!environments/*/terraform.tfvars
!bootstrap/*/terraform.tfvars
backend.hcl

# Saved plans and rendered plan output
*.tfplan
tfplan
plan.txt
*-plan.txt

# Generated handoff / validation artefacts
handoff/
outputs.json
*-outputs.json
run-metadata.json
state-before.txt
state-after.txt
state-list.txt
apply.log
plan-checksum.txt
connectivity-test-results.json

# Network diagrams (binary)
*.vsdx

# Provider lock files are resolved per run by the pipelines, not pinned in git.
.terraform.lock.hcl
