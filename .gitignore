handoff/
dev-outputs.json
connectivity-test-results.json

# Rehearsal scaffolding: used locally to build the mock on-prem hub,
# never part of the client deliverable. Kept on disk, not in git.
sandbox/

# Client network diagram (binary) and a stale release manifest.
*.vsdx
SHA256SUMS.txt
