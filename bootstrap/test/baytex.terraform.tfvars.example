# BAYTEX DELIVERY VALUES for the test Terraform state backend.
#
# Kept alongside terraform.tfvars.example, which holds the values this repository is tested with. To deliver, copy this
# into the BOOTSTRAP_TFVARS content for test in the Baytex repository.

# Entra tenant and the subscription holding test state (SUB-BTE-CAN-DATA-TEST).
tenant_id       = "9a6302b1-6a51-4f41-ad6b-ad23218c074d"
subscription_id = "bfef19b8-0ffb-46b0-b654-53f1c1cc8a5b"
location        = "canadacentral"

# These three must match TF_STATE_RESOURCE_GROUP, TF_STATE_STORAGE_ACCOUNT and TF_STATE_CONTAINER on the same GitHub
# Environment. The storage account name is globally unique across all of Azure.
resource_group_name  = "rg-bte-dbx-test-tfstate-cnc-001"
storage_account_name = "stbtedbxtesttfcnc001"
container_name       = "tfstate"

tags = {
  Application = "AzureDatabricks"
  Environment = "Test"
  ManagedBy   = "Terraform"
}

# Object IDs, not application IDs. The deployment service principal already holds Storage Blob Data Contributor at
# subscription scope, so this is only for a human operator who needs to read state directly.
state_blob_data_contributor_principal_ids = []
