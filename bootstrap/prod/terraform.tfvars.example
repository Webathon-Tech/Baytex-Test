# Values for the prod Terraform state backend.
# The whole of this file is held in the BOOTSTRAP_TFVARS variable on the prod-plan and prod-apply GitHub Environments, and the workflow writes it to disk as terraform.tfvars at run time.
# Values for Baytex's own subscriptions are kept in baytex.terraform.tfvars.example alongside this file.

# ----------------------------------------------------------------------------------------------------------------------
# Subscription
# ----------------------------------------------------------------------------------------------------------------------

# Entra tenant and the subscription that holds prod state. Each environment can use its own subscription.
tenant_id       = "be945e7a-2e17-4b44-926f-512e85873eec"
subscription_id = "6a3bb170-5159-4bff-860b-aa74fb762697"
location        = "canadacentral"

# ----------------------------------------------------------------------------------------------------------------------
# State storage
# ----------------------------------------------------------------------------------------------------------------------

# These three must match TF_STATE_RESOURCE_GROUP, TF_STATE_STORAGE_ACCOUNT and TF_STATE_CONTAINER on the same GitHub Environment.
# The storage account name is globally unique across Azure.
resource_group_name  = "rg-vkp-dbx-prod-tfstate-cnc-001"
storage_account_name = "stvkpdbxprodtfcnc001"
container_name       = "tfstate"

# Tags applied to the resource group and storage account.
tags = {
  Application = "AzureDatabricks"
  Environment = "Prod"
  ManagedBy   = "Terraform"
}

# ----------------------------------------------------------------------------------------------------------------------
# Access
# ----------------------------------------------------------------------------------------------------------------------

# Object IDs, not application IDs, of operators who need direct access to state.
# The deployment service principal already holds Storage Blob Data Contributor at subscription scope. Example:
#   state_blob_data_contributor_principal_ids = ["00000000-0000-0000-0000-000000000000"]
state_blob_data_contributor_principal_ids = []
