# HAProxy configuration, rendered by Terraform and applied to each VM by the Custom Script Extension.
# The extension replaces the running configuration only after haproxy -c accepts it, and reloads HAProxy gracefully.
# One TCP frontend and backend per on-premises destination, plus an HTTP health frontend on port 8404 for the load balancer probe.

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    # TCP keepalives on both sides keep long-idle database sessions open through the load balancer, Private Link and
    # firewall idle timers, and close a session whose peer has gone away.
    option  clitcpka
    option  srvtcpka
    clitcpka-idle  180s
    clitcpka-intvl 30s
    clitcpka-cnt   4
    srvtcpka-idle  180s
    srvtcpka-intvl 30s
    srvtcpka-cnt   4
    timeout connect 10s
    timeout client  1h
    timeout server  1h
    timeout check   10s

resolvers baytex_dns
%{ for index, dns in dns_servers ~}
    nameserver dns${index + 1} ${dns}:53
%{ endfor ~}
    resolve_retries 3
    timeout resolve 2s
    timeout retry   2s
    hold valid      30s

frontend health
    bind *:8404
    mode http
    http-request return status 200 content-type text/plain string OK

%{ for key, endpoint in endpoints ~}
frontend fe_${replace(key, "-", "_")}
    bind ${endpoint.frontend_ip}:${endpoint.listen_port}
    mode tcp
    default_backend be_${replace(key, "-", "_")}

backend be_${replace(key, "-", "_")}
    mode tcp
    option tcp-check
    server ${replace(key, "-", "_")} ${endpoint.target_fqdn}:${endpoint.target_port} check inter 5s fall 3 rise 2 resolvers baytex_dns init-addr last,libc,none

%{ endfor ~}
